flowchart TB
    raw[(Исходный JSON<br/>≈250 тыс. строк)]

    engine["src/parser/engine.py<br/><b>MISParser</b><br/><small>фасад</small>"]
    builder["src/parser/canonical/builder.py<br/><small>вызов адаптеров и композиция PatientRecord</small>"]
    adapters["<b>Адаптеры блоков JSON</b><br/>patient.py · social.py · encounters.py<br/>observations/* · history.py"]
    support["<b>Общие механизмы src/parser</b><br/>records.py · normalizers.py · canonical/common.py<br/>canonical/dates.py · extractors.py"]

    contract["PatientRecord 1.0<br/><small>strict Pydantic contract</small>"]
    storage_module["src/storage/patient_records.py<br/><small>валидация и атомарная запись</small>"]
    storage[(patient_record.json<br/>опционально)]

    raw --> engine --> builder --> contract
    builder -. "вызывает" .-> adapters
    support -. "правила чтения и нормализации" .-> adapters
    contract -. "parse(): save" .-> storage_module --> storage

    classDef input fill:#fff7ed,stroke:#f59e0b,color:#7c2d12,stroke-width:2px;
