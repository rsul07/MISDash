flowchart LR
    raw[(Исходный JSON<br/>≈250 тыс. строк)]

    subgraph parser["src/parser"]
        engine["MISParser<br/><small>фасад</small>"]
        builder["canonical/builder.py<br/><small>формирование каноничного json</small>"]

        subgraph support["Общие механизмы"]
            records["records.py<br/>получение полей с опечатками · удаление дупликатов"]
            normalizers["normalizers.py<br/>приведение дат и чисел к одному типу данных"]
            extractors["extractors.py<br/>метрики из текста (АД, ЧСС)"]
        end

        subgraph adapters["Адаптеры"]
            patient["patient.py<br/>пациент · аллергии · диагнозы"]
            social["social.py<br/>социальный и семейный анамнез"]
            encounters["encounters.py<br/>приёмы · жалобы · планы"]
            observations["observations/<br/>лаборатория · дневник"]
            history["history.py<br/>операции · госпитализации · исследования"]
        end
    end

    contract["PatientRecord v1<br/><small>strict Pydantic contract</small>"]
    storage[(patient_record.json<br/>опционально)]

    raw --> engine --> builder
    records -.-> builder
    normalizers -.-> builder
    extractors -.-> encounters
    extractors -.-> observations
    builder --> patient & social & encounters & observations & history
    patient & social & encounters & observations & history --> contract
    contract -. "parse()" .-> storage

    classDef input fill:#fff7ed,stroke:#f59e0b,color:#7c2d12,stroke-width:2px;
    classDef facade fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:2px;
    classDef support fill:#f8fafc,stroke:#94a3b8,color:#334155;
    classDef adapter fill:#ecfdf5,stroke:#10b981,color:#064e3b;
    classDef contract fill:#f3e8ff,stroke:#9333ea,color:#581c87,stroke-width:2px;
    class raw input;
    class engine,builder facade;
    class records,normalizers,extractors support;
    class patient,social,encounters,observations,history adapter;
    class contract,storage contract;
