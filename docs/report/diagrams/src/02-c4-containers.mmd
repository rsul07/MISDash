flowchart LR
    subgraph actors["Пользователи и внешние источники"]
        direction LR
        mis["«external system»<br/><b>МИС</b><br/><small>Исходный JSON</small>"]
        doctor["«person»<br/><b>Врач</b><br/><small></small>"]
    end

    subgraph system["Software system: MIS Dash"]
        direction TB

        subgraph ingestion["Детерминированная обработка"]
            direction LR
            parser["«container»<br/><b>MISParser</b><br/><small>нормализация</small>"]
            record["«container»<br/><b>PatientRecord v1</b><br/><small>полная каноническая история</small>"]
            storage[("«container»<br/><b>Canonical JSON</b><br/><small>опциональное хранение</small>")]
            parser --> record
            record -. "parse()" .-> storage
        end

        subgraph delivery["Backend-driven представление"]
            direction LR
            backend["«container»<br/><b>DashboardService</b><br/><small>frontend-проекции</small>"]
            calculators["«container»<br/><b>Clinical calculators</b><br/><small>eGFR · липиды · пульсовое давление</small>"]
            response["«container»<br/><b>DashboardResponse v1</b><br/><small>стабильный UI-контракт</small>"]
            web["«container»<br/><b>Streamlit UI</b><br/><small>карточка · графики · приёмы</small>"]
            backend -->|"нормализованные входы"| calculators
            calculators -. "расчётные ряды" .-> backend
            backend --> response --> web
        end

        subgraph optional["Опциональный ИИ-контур"]
            direction LR
            summary["«container»<br/><b>SummaryService</b><br/><small></small>"]
            airesult["«contract»<br/><b>ClinicalSummary</b><br/><small>structured output</small>"]
            summary --> airesult
        end

        record -->|"полная история"| backend
        record -. "текст и события" .-> summary
        response -. "видимые факты и метрики" .-> summary
        airesult -. "только по кнопке" .-> web
    end

    gemini["«external system»<br/><b>Gemini API</b><br/><small>Structured output</small>"]

    mis -->|"выгрузка → MISParser"| system
    doctor -->|"browser → Streamlit UI"| system
    system -->|"SummaryService → HTTPS / JSON"| gemini

    classDef person fill:#084c82,stroke:#052f52,color:#ffffff,stroke-width:3px;
    classDef internal fill:#e0f2fe,stroke:#0284c7,color:#0f172a,stroke-width:2px;
    classDef contract fill:#f3e8ff,stroke:#9333ea,color:#3b0764,stroke-width:2px;
    classDef ai fill:#ecfdf5,stroke:#059669,color:#064e3b,stroke-width:2px;
    classDef external fill:#e2e8f0,stroke:#64748b,color:#0f172a,stroke-width:2px;
    class doctor person;
    class parser,backend,calculators,web internal;
    class record,response,storage,airesult contract;
    class summary ai;
    class mis,gemini external;
    style actors fill:#ffffff,stroke:#cbd5e1,stroke-width:1px
    style ingestion fill:#f8fafc,stroke:#94a3b8,stroke-width:1px
    style delivery fill:#f8fafc,stroke:#94a3b8,stroke-width:1px
    style optional fill:#f0fdf4,stroke:#86efac,stroke-width:1px
    style system fill:#ffffff,stroke:#334155,stroke-width:3px
